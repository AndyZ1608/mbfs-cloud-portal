# ================== MBFS Cloud Portal ==================
# Copy file này thành .env rồi sửa theo môi trường của anh.

# --- Chế độ demo (không cần OpenStack) ---
# true  = dữ liệu giả lập trong bộ nhớ, đăng nhập tài khoản bất kỳ
# false = kết nối OpenStack thật qua các biến OS_* bên dưới
OS_MOCK=true

# --- Kết nối OpenStack (khi OS_MOCK=false) ---
# URL Keystone v3, ví dụ: https://openstack.mbfs.vn:5000/v3
OS_AUTH_URL=https://controller:5000/v3
OS_REGION_NAME=RegionOne
# public | internal | admin — endpoint nào portal gọi tới các service
OS_INTERFACE=public
# Domain mặc định điền sẵn ở form đăng nhập
OS_DEFAULT_DOMAIN=Default
# Nova microversion (2.60 chạy tốt từ Queens trở lên; hạ xuống 2.42 nếu bản cũ)
OS_COMPUTE_MICROVERSION=2.60
# true nếu OpenStack dùng chứng chỉ tự ký (self-signed TLS)
OS_INSECURE=false

# --- Portal ---
PORT=8080
# Optional override for the YAML application/service configuration file.
# CMP_CONFIG_FILE=/app/config/application.yml
# Bắt buộc ở production; tạo bằng: openssl rand -hex 32
SESSION_SECRET=
# Tuỳ chọn: khoá riêng để mã hoá secret hạ tầng lưu trong DATA_DIR.
# Nếu bỏ trống, portal dùng SESSION_SECRET. Không đổi khoá khi còn cluster đã lưu.
DATA_ENCRYPTION_KEY=
# Timeout OpenStack thông thường (1–300 giây), upload image/Swift (1 phút–24 giờ), và thời hạn phiên
OS_REQUEST_TIMEOUT_MS=30000
OS_UPLOAD_TIMEOUT_MS=3600000
# Uploads are staged in this directory; Docker Compose uses /data/image-upload-temp.
# Ensure it has free space for concurrent uploads (each file is strictly below 15 GiB).
IMAGE_UPLOAD_TEMP_DIR=
SESSION_TTL_SEC=28800
# Tên hiển thị trên giao diện
CLOUD_NAME=MBFS Cloud

# --- Khi chạy sau reverse proxy HTTPS (nginx) ---
# SECURE_COOKIES=true  → cookie chỉ gửi qua HTTPS
# TRUST_PROXY=true     → tin header X-Forwarded-* từ nginx
SECURE_COOKIES=false
TRUST_PROXY=false

# --- Tác vụ nền: backup tự động + cảnh báo (v1.3, tuỳ chọn) ---
# Tài khoản dịch vụ Keystone (role member trên các project cần backup/giám sát).
# Bỏ trống = tắt scheduler backup và cảnh báo Telegram.
OS_TASK_USERNAME=
OS_TASK_PASSWORD=
# OS_TASK_DOMAIN=Default

# Múi giờ cho lịch backup (container mặc định UTC nếu bỏ trống)
TZ=Asia/Ho_Chi_Minh

# Nơi lưu policies/nhật ký — đã mount volume portal-data:/data trong compose
# DATA_DIR=/data

# --- Cảnh báo Telegram (v1.3, tuỳ chọn) ---
# Bot gửi cảnh báo: quota vượt ngưỡng, máy ảo ERROR, load balancer suy giảm.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Ngưỡng % quota để cảnh báo (mặc định 85)
ALERT_QUOTA_PCT=85
# Quét mỗi N phút (mặc định 5) / nhắc lại sự cố sau N giờ (mặc định 6)
ALERT_INTERVAL_MIN=5
ALERT_REPEAT_HOURS=6

# ================== SSO Keycloak — Phase 1 identity binding ==================
# SSO xác minh danh tính/liên kết Keystone, KHÔNG cấp quyền OpenStack API.
# Đăng nhập Keystone cục bộ vẫn cần thiết cho tài nguyên đến khi có federation.
SSO_ENABLED=false
OIDC_ISSUER_URL=https://keycloak.mbfs.vn/realms/mbfs
OIDC_CLIENT_ID=mbfs-cloud-portal
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://cloud.mbfs.vn/api/auth/sso/callback
OIDC_SCOPES=openid profile email
SSO_BUTTON_LABEL=Đăng nhập với SSO
# Danh tính dịch vụ riêng, chỉ đủ quyền đọc/tạo/xóa Keystone User trong domain.
# Không dùng OS_TASK_* hoặc quyền admin Nova/Neutron/Cinder cho SSO.
SSO_KEYSTONE_USERNAME=
SSO_KEYSTONE_PASSWORD=
SSO_KEYSTONE_DOMAIN=Default
# Tạo user không mật khẩu; mặc định tắt, bật sau khi cấp quyền Keystone phù hợp.
SSO_PROVISIONING_ENABLED=false

# ============ SSO ĐÚNG CHUẨN: Keystone WebSSO federation (v2.0) ============
# Dùng khi Keystone đã cấu hình federation (giống Horizon đang chạy).
# Ưu điểm: token là CỦA CHÍNH NGƯỜI DÙNG → không cần OS_TASK_*, không cần nhóm
# Keycloak; project list lấy thẳng từ Keystone; Nova ghi đúng người tạo VM.
OS_WEBSSO_ENABLED=false
# Tên identity provider trong Keystone (openstack identity provider list)
OS_WEBSSO_IDP=mbfs
# Protocol (openstack federation protocol list --identity-provider <idp>)
OS_WEBSSO_PROTOCOL=openid
# BẮT BUỘC: URL người dùng gõ để vào portal — phải trùng trusted_dashboard bên Keystone
PUBLIC_URL=https://cloud.mbfs.vn
OS_WEBSSO_LABEL=Đăng nhập bằng SSO
# Tuỳ chọn: URL đăng xuất Keycloak (kết thúc cả phiên IdP khi bấm Đăng xuất)
# OS_WEBSSO_LOGOUT_URL=https://keycloak.mbfs.vn/realms/mbfs/protocol/openid-connect/logout

# URL Keystone mà TRÌNH DUYỆT dùng cho WebSSO — thường KHÁC OS_AUTH_URL.
# Phải là endpoint public đã cấu hình mod_auth_openidc (chính URL Horizon dùng).
# Bỏ trống = dùng OS_AUTH_URL (chỉ đúng khi hai cái trùng nhau).
OS_WEBSSO_URL=https://keystone.mbfs.vn:5000

# --- Giám sát VM (v2.2, tuỳ chọn — cần OS_TASK_* và quyền đọc Nova diagnostics) ---
# Cấp quyền: openstack role add --project <p> --user portal-task admin
#   HOẶC sửa /etc/nova/policy.yaml:
#   "os_compute_api:os-server-diagnostics": "rule:admin_or_owner"
MONITOR_INTERVAL_SEC=120
MONITOR_RETENTION_H=24
ALERT_CPU_PCT=90
# Deep-link sang Grafana/Coroot nếu có, hỗ trợ {name} {id}
MONITOR_URL_TEMPLATE=

# --- Ngưỡng khuyến nghị "máy CPU thấp" ở trang Tối ưu tài nguyên ---
OPTIMIZE_IDLE_CPU_PCT=5
# Số giờ dữ liệu tối thiểu trước khi dám kết luận (mặc định: nửa kỳ quét, tối đa 24h)
# OPTIMIZE_MIN_SPAN_H=12

# ================== Vận hành sản xuất (v2.4) ==================
# Lưu phiên đăng nhập: memory (mặc định) | file | redis
#   file  → restart container không mất phiên (lưu trong DATA_DIR/sessions)
#   redis → chạy được NHIỀU replica sau load balancer (HA)
SESSION_STORE=memory
REDIS_URL=redis://127.0.0.1:6379
# REDIS_PASSWORD=
# REDIS_PREFIX=mbfs:sess:

# Chống dò mật khẩu: tối đa N lần gọi /auth/login mỗi IP trong cửa sổ thời gian
RATE_LOGIN_MAX=10
RATE_LOGIN_WINDOW_SEC=300
# Hạn mức API chung mỗi IP (0 = tắt)
RATE_API_MAX=600
RATE_API_WINDOW_SEC=60
